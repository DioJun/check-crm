generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())
}

model Lead {
  id                String   @id @default(uuid())
  nome              String
  telefone          String?
  cidade            String?
  servico           String?
  status            String   @default("novo")
  origem            String?
  dataEntrada       DateTime @default(now())
  ultimaInteracao   DateTime?
  avaliacao         String?
  reviews           String?
  temWhatsapp       Boolean?
  temSite           Boolean?
  site              String?
  googleMapsRating  String?  // Alto, Medio, Baixo, NaoTem
  hasProduct        Boolean? // Já tem produto/serviço digital
  instagram         String?  // @usuario
  instagramQuality  String?  // Bom, Medio, Ruim, NaoTem
  observacoes       String?  // Anotações livres
  porte             String?  // Pequeno, Medio, Grande
  tempoMercado      String?  // Menos1ano, 1a3anos, 3a5anos, Mais5anos
  aiAnalysis        String?
  aiAnalysisAt      DateTime?
  interacoes        Interacao[]
}

model Interacao {
  id       String   @id @default(uuid())
  leadId   String
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo     String   @default("mensagem")
  conteudo String
  data     DateTime @default(now())
}
