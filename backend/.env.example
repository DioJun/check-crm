# Backend Configuration

# Database
DATABASE_URL="file:./dev.db"
DATABASE_PROVIDER="sqlite"

# Environment
NODE_ENV="development"
IS_ELECTRON="false"

# JWT
JWT_SECRET="your-super-secret-key-change-this-in-production"

# API v1 Configuration
CRM_API_KEY="your-crm-api-key-generate-a-strong-one"
CRM_WEBHOOK_SECRET="your-webhook-hmac-secret-must-match-client-side"

# Optional: Webhook URL where events will be sent
# WEBHOOK_URL="https://your-ai-service.com/webhooks/crm"

# Google Gemini API (optional)
GEMINI_API_KEY="your-google-gemini-api-key"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3001"
